// ============================================================
//  BMU.Marketing — Prisma schema (PostgreSQL)
//  Setup: cp .env.example .env  ->  npm run db:push  ->  npm run db:seed
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- enums ----------------

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
  CLIENT
  CREATOR
  BUSINESS // QR platform tenant
}

enum ProjectStatus {
  DISCOVERY
  IN_PROGRESS
  REVIEW
  LIVE
  PAUSED
  COMPLETED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT
  PROPOSAL
  WON
  LOST
}

enum LeadSource {
  META_ADS
  GOOGLE_ADS
  ORGANIC
  REFERRAL
  WHATSAPP
  QR_SCAN
  WALK_IN
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum QrType {
  URL
  MENU
  GOOGLE_REVIEW
  WHATSAPP
  PAYMENT
  FEEDBACK
  CATALOGUE
  BUSINESS_CARD
  OFFER
  VCARD
}

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

// ---------------- identity ----------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  phone         String?
  image         String?
  role          Role      @default(CLIENT)
  passwordHash  String?
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  creator         Creator?
  notifications   Notification[]
  ticketsOpened   SupportTicket[]   @relation("TicketAuthor")
  ticketsAssigned SupportTicket[]   @relation("TicketAssignee")
  approvals       ContentApproval[]
  managedProjects Project[]         @relation("ProjectManager")
  assignedTasks   ProjectTask[]     @relation("TaskAssignee")
  uploadedMedia   MediaAsset[]
  accounts        Account[]
  sessions        Session[]

  @@index([clientId])
  @@index([role])
}

model Client {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  industry        String
  city            String?
  website         String?
  logoUrl         String?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  gstin           String?
  monthlyRetainer Int? // paise
  onboardedAt     DateTime @default(now())
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users        User[]
  projects     Project[]
  leads        Lead[]
  invoices     Invoice[]
  campaigns    Campaign[]
  qrCodes      QrCode[]
  locations    Location[]
  reviews      Review[]
  reports      Report[]
  tickets      SupportTicket[]
  rankings     SeoRanking[]
  subscription Subscription?
  approvals    ContentApproval[]
  media        MediaAsset[]

  @@index([isActive])
  @@index([createdAt])
}

model Location {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  city       String?
  lat        Float?
  lng        Float?
  gbpPlaceId String?
  createdAt  DateTime @default(now())

  qrCodes QrCode[]
  reviews Review[]

  @@index([clientId])
}

// ---------------- delivery ----------------

model Service {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  category    String // marketing | content | design | development | automation | seo | branding | ai | realEstate
  description String?
  basePrice   Int? // paise
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  projects ProjectService[]
}

model Project {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  managerId   String?
  manager     User?         @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  name        String
  description String?
  status      ProjectStatus @default(DISCOVERY)
  progress    Int           @default(0)
  budget      Int?
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  services  ProjectService[]
  approvals ContentApproval[]
  invoices  Invoice[]
  media     MediaAsset[]
  tasks     ProjectTask[]
  updates   ProjectUpdate[]

  @@index([clientId, status])
  @@index([updatedAt])
}

/// Work items inside a project. Progress on the project is derived from
/// these rather than typed, so a status update can't drift from the work.
model ProjectTask {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  /// Which service line it belongs to — Development, Design, Branding, etc.
  discipline  String    @default("Delivery")
  /// TODO | IN_PROGRESS | BLOCKED | REVIEW | DONE
  status      String    @default("TODO")
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Rough size, used to weight progress. A one-hour task and a two-week
  /// task counting equally is what makes percentages meaningless.
  weight      Int       @default(1)
  dueDate     DateTime?
  completedAt DateTime?
  notes       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, status])
  @@index([assigneeId])
}

/// A dated entry on the project timeline — what actually happened and when.
/// This is what a progress report is built from.
model ProjectUpdate {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String
  /// MILESTONE | NOTE | BLOCKER | DELIVERY
  kind       String   @default("NOTE")
  title      String
  body       String?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}

model ProjectService {
  id        String  @id @default(cuid())
  projectId String
  serviceId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([projectId, serviceId])
}

model ContentApproval {
  id           String         @id @default(cuid())
  clientId     String
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title        String
  type         String // reel | post | carousel | video | banner | copy
  assetUrl     String?
  caption      String?
  scheduledFor DateTime?
  status       ApprovalStatus @default(PENDING)
  feedback     String?
  reviewedById String?
  reviewedBy   User?          @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  /// Bumped each time changes are requested. Three or more usually means the
  /// brief was wrong, not the creative — that's the number worth escalating on.
  revision     Int            @default(1)
  /// When it was first sent to the client. Ageing is measured from here, not
  /// from creation, because sitting in our own queue isn't the client's delay.
  sentAt       DateTime?
  lastNudgedAt DateTime?
  /// Set when someone senior takes ownership of an approval that's gone cold.
  escalatedAt  DateTime?
  escalatedTo  String?

  comments ApprovalComment[]

  @@index([clientId, status])
  @@index([status, sentAt])
  @@index([scheduledFor])
}

/// The thread on an approval. Kept as rows rather than one feedback string so
/// a revision cycle can be read back afterwards.
model ApprovalComment {
  id         String          @id @default(cuid())
  approvalId String
  approval   ContentApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String
  /// CLIENT | AGENCY
  side       String          @default("AGENCY")
  body       String
  /// True for the comment that accompanied a change request.
  isDecision Boolean         @default(false)
  createdAt  DateTime        @default(now())

  @@index([approvalId, createdAt])
}

// ---------------- growth ----------------

model Campaign {
  id          String         @id @default(cuid())
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  platform    String // meta | google | whatsapp | influencer | email
  status      CampaignStatus @default(DRAFT)
  budget      Int?
  spend       Int            @default(0)
  impressions Int            @default(0)
  clicks      Int            @default(0)
  conversions Int            @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  leads    Lead[]
  bookings CreatorBooking[]

  @@index([clientId, status])
  @@index([updatedAt])
}

model Lead {
  id              String     @id @default(cuid())
  clientId        String
  client          Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  name            String
  phone           String?
  email           String?
  message         String?
  source          LeadSource @default(OTHER)
  status          LeadStatus @default(NEW)
  score           Int        @default(0)
  value           Int?
  /// User ID of whoever owns this lead. Null means nobody has picked it up.
  assignedTo      String?
  assignedAt      DateTime?
  lastContactedAt DateTime?
  /// Set when the status first moves off NEW — this is the number that
  /// actually predicts conversion, so it's stored rather than derived.
  firstResponseAt DateTime?
  lostReason      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  notes LeadNote[]

  @@index([clientId, status])
  @@index([assignedTo, status])
  @@index([createdAt])
}

/// Every touch on a lead: notes, status moves, reassignments.
/// Kept as one append-only trail so "what happened here" is a single query.
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  authorName String?
  /// NOTE | STATUS | ASSIGN | CALL | WHATSAPP | EMAIL
  kind      String   @default("NOTE")
  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model Creator {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle     String   @unique
  city       String?
  categories String[]
  followers  Int      @default(0)
  avgViews   Int      @default(0)
  rateCard   Int?
  isVerified Boolean  @default(false)
  bio        String?
  /// Payout details. Creators are usually paid by UPI; PAN is needed for TDS
  /// once they pass the annual threshold.
  upiId      String?
  panNumber  String?
  createdAt  DateTime @default(now())

  bookings CreatorBooking[]

  @@index([city])
}

model CreatorBooking {
  id           String   @id @default(cuid())
  creatorId    String
  creator      Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  deliverables String
  fee          Int
  status       String   @default("BOOKED")
  createdAt    DateTime @default(now())

  @@index([campaignId])
}

// ---------------- BMU QR ----------------

model QrCode {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  slug       String    @unique
  label      String
  type       QrType    @default(URL)
  target     String
  isDynamic  Boolean   @default(true)
  isActive   Boolean   @default(true)
  password   String?
  scanCount  Int       @default(0)
  lastScanAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  scans ScanEvent[]

  @@index([clientId, type])
  @@index([scanCount])
}

model ScanEvent {
  id        String   @id @default(cuid())
  qrCodeId  String
  qrCode    QrCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  city      String?
  country   String?
  device    String?
  referrer  String?
  scannedAt DateTime @default(now())

  @@index([qrCodeId, scannedAt])
}

model Subscription {
  id               String             @id @default(cuid())
  clientId         String             @unique
  client           Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tier             SubscriptionTier   @default(STARTER)
  status           SubscriptionStatus @default(TRIALING)
  amount           Int
  interval         String             @default("MONTHLY")
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  razorpaySubId    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// ---------------- reputation & SEO ----------------

model Review {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  rating      Int
  comment     String?
  authorName  String?
  platform    String    @default("GOOGLE")
  isPublic    Boolean   @default(true)
  routedToOps Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([clientId, rating])
}

model SeoRanking {
  id               String   @id @default(cuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  keyword          String
  position         Int
  previousPosition Int?
  volume           Int?
  url              String?
  checkedAt        DateTime @default(now())

  @@index([clientId, checkedAt])
}

// ---------------- money ----------------

model Invoice {
  id                String        @id @default(cuid())
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  number            String        @unique
  status            InvoiceStatus @default(DRAFT)
  subtotal          Int
  taxRate           Float         @default(18)
  total             Int
  amountPaid        Int           @default(0)
  issuedAt          DateTime      @default(now())
  dueAt             DateTime?
  paidAt            DateTime?
  notes             String?
  razorpayPaymentId String?

  items InvoiceItem[]

  @@index([clientId, status])
  @@index([issuedAt])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Int
  amount      Int

  @@index([invoiceId])
}

// ---------------- support & reporting ----------------

model SupportTicket {
  id         String       @id @default(cuid())
  clientId   String
  client     Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId   String
  author     User         @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?        @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  subject    String
  body       String
  status     TicketStatus @default(OPEN)
  priority   Priority     @default(MEDIUM)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([clientId, status])
  @@index([updatedAt])
}

model Report {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  periodStart DateTime
  periodEnd   DateTime
  fileUrl     String?
  summary     String?
  metrics     Json?
  createdAt   DateTime @default(now())

  @@index([clientId, periodEnd])
}

model MediaAsset {
  id           String   @id @default(cuid())
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  url          String
  key          String   @unique
  filename     String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  /// Folder path like "atria-living/tower-c/drone". Stored as a string rather
  /// than a folder table because folders here are just a naming convention —
  /// a real tree would need moves, renames and orphan handling for no gain.
  folder       String   @default("")
  tags         String[]
  /// Written on the asset so it travels with the file into a post or profile.
  altText      String?
  /// Archived assets stay in storage but drop out of the picker. Deleting a
  /// file that's live on a client's site is not recoverable.
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([clientId])
  @@index([folder])
  @@index([isArchived, createdAt])
}

/// Per-person overrides on top of role defaults. Denials always win, so a
/// grant can never accidentally re-open something explicitly revoked.
/// Sub-roles built in the admin panel. A custom role inherits a base role's
/// defaults and then adds or removes specific modules, so it can never grant
/// more than the base role is allowed to hold.
model CustomRole {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  /// One of the built-in roles this sits on top of.
  baseRole    String   @default("STAFF")
  /// { "leads": ["view","edit"], "invoices": [] }
  permissions Json
  memberCount Int      @default(0)
  isActive    Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model UserPermission {
  id        String   @id @default(cuid())
  userId    String
  module    String
  actions   String[]
  /// GRANT adds to the role default, DENY subtracts from it.
  kind      String   @default("GRANT")
  grantedBy String?
  createdAt DateTime @default(now())

  @@unique([userId, module, kind])
  @@index([userId])
}

/// Which client accounts a manager or staff member is responsible for.
model StaffAssignment {
  id         String   @id @default(cuid())
  userId     String
  clientId   String?
  businessId String?
  /// LEAD | SUPPORT | REVIEWER
  duty       String   @default("LEAD")
  note       String?
  assignedBy String?
  createdAt  DateTime @default(now())

  @@unique([userId, clientId, businessId])
  @@index([userId])
  @@index([clientId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ---------------- public site content ----------------

model PortfolioItem {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String
  clientName  String?
  summary     String?
  coverUrl    String?
  isFeatured  Boolean  @default(false)
  publishedAt DateTime @default(now())

  @@index([category])
}

model CaseStudy {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  industry       String
  headlineMetric String
  summary        String
  services       String[]
  publishedAt    DateTime @default(now())
}

model Testimonial {
  id         String   @id @default(cuid())
  author     String
  role       String?
  company    String?
  quote      String
  rating     Int      @default(5)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  body        String
  coverUrl    String?
  tags        String[]
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

/// A creator's answer to a brief. Kept as its own model rather than a status
/// on the brief, because a brief goes to several creators and each response
/// has its own terms and thread.
model BriefResponse {
  id         String   @id @default(cuid())
  briefId    String
  creatorId  String
  /// ACCEPTED | DECLINED | QUESTION
  decision   String
  message    String?
  /// What they'd charge for this specific brief, in paise. Often differs from
  /// their rate card once deliverables and usage rights are known.
  quotedFee  Int?
  /// When they can deliver by, if different from the brief's date.
  proposedAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([briefId, creatorId])
  @@index([briefId])
  @@index([creatorId, createdAt])
}

model CreatorApplication {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  handle     String
  platform   String   @default("INSTAGRAM")
  city       String?
  categories String[]
  followers  Int      @default(0)
  rateCard   Int? // paise per deliverable
  portfolio  String?
  pitch      String?
  status     String   @default("NEW") // NEW | REVIEWING | ACCEPTED | DECLINED
  reviewedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model Appointment {
  id           String    @id @default(cuid())
  name         String
  email        String?
  phone        String?
  need         String?
  message      String?
  scheduledFor DateTime?
  isHandled    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([isHandled])
}

/// Leads from the public website forms, shown in the admin portal (/admin-portal).
/// `form` is "quick" (landing page) or "contact" (/contact page).
model WebsiteLead {
  id              String    @id @default(cuid())
  form            String
  name            String
  phone           String
  email           String?
  need            String?
  company         String?
  budget          String?
  message         String?
  page            String?
  referrer        String?
  /// Review status: "new" | "follow_up" | "converted" | "rejected"
  status          String    @default("new")
  statusUpdatedAt DateTime?
  createdAt       DateTime  @default(now())

  @@index([form, createdAt])
  @@index([status])
}


// ---------------- Auth.js ----------------
// Required only if you switch from JWT sessions to the Prisma adapter,
// or add an OAuth provider such as Google. Harmless to keep either way.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


// ============================================================
//  CMS — makes the public site editable from the admin panel
// ============================================================

model ContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique // "home.hero", "services.index", "pricing.plans"
  label     String
  group     String   @default("general")
  data      Json
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([group])
}

/// Any repeatable content type on the public site — services, products,
/// portfolio, articles, store items and so on. One table, many collections,
/// so a new content type needs a registry entry rather than a migration.
model ContentItem {
  id          String   @id @default(cuid())
  collection  String // "services" | "products" | "portfolio" | ...
  slug        String
  title       String
  data        Json
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([collection, slug])
  @@index([collection, sortOrder])
  @@index([collection, isPublished])
}

/// Editable industry configuration. Falls back to the code defaults in
/// src/lib/industry-setup.ts, so an empty table still produces a working app.
model IndustrySetting {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  category       String   @default("OTHER")
  primaryActions String[]
  modules        String[]
  kpis           String[]
  plan           String   @default("BUSINESS")
  kit            String[]
  primaryGoal    String
  heroMetric     String
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// A page built in the admin panel rather than in code.
///
/// Sections are stored as a JSON array rather than rows, because they're
/// always read and written together as a whole page — splitting them into a
/// table would buy nothing and cost a join on every render.
model CustomPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  /// Shown in the page header. Optional — some pages open straight into content.
  subtitle    String?
  sections    Json     @default("[]")
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean  @default(false)
  /// Appears in the main navigation when set.
  navLabel    String?
  navOrder    Int      @default(100)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================================
//  BMU QR PLATFORM — multi-tenant business operating system
// ============================================================

enum BusinessCategory {
