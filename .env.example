# PostgreSQL (Neon, Supabase, Railway or local Docker)
DATABASE_URL="postgresql://user:password@localhost:5432/bmu?schema=public"

# Auth.js — required in production, optional in local dev.
# Generate one with:  npx auth secret
AUTH_SECRET=""
# Local only — leave unset on Vercel (it detects the URL itself)
AUTH_URL="http://localhost:3000"

# Optional Google sign-in. Leave blank to hide the button entirely.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Demo logins (admin@bmu.marketing / bmu-admin etc.) work everywhere, including
# production. Set to "off" to disable them once real accounts exist.
DEMO_ACCOUNTS="on"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay — leave blank to run payments in demo mode (no charge, flow still works)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Cloudflare R2 — leave blank and the uploader says so instead of failing
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="bmu-media"
R2_PUBLIC_URL=""

# Email — leave blank and messages are logged instead of sent
RESEND_API_KEY=""
EMAIL_FROM="BMU.Marketing <hello@bmu.marketing>"
EMAIL_INTERNAL="hello@bmu.marketing"

# Google Sheets — every website form submission (with the page it came from) is
# appended to a sheet. Setup steps are in scripts/google-sheets-webhook.gs.
# Leave blank and submissions are only logged.
GOOGLE_SHEETS_WEBHOOK_URL=""
GOOGLE_SHEETS_SECRET=""

# Analytics — each script loads only if its key exists
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_CLARITY_ID=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# AI — leave blank and the assistant falls back to built-in templates
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL="claude-sonnet-4-6"
